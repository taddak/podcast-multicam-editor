# Don't edit this by hand: run `python -m trader keys`, which asks for each key with hidden input
# and writes .env readable only by you. Never commit .env, never paste keys into a chat.
#
# Only these four names are read from .env; anything else in the file is ignored.

# Claude API key (https://platform.claude.com, ideally from a workspace with a spend limit)
ANTHROPIC_API_KEY=

# Exchange API key, needed only for live trading. Permissions: View + Trade, NEVER Withdraw.
# Restrict it to your IP address if you have a fixed one.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Only OKX uses an extra passphrase:
EXCHANGE_API_PASSWORD=
