# Copy to .env and fill in. Never commit the real .env.

# Claude API key (https://console.anthropic.com) - needed for brain.type = "claude"
ANTHROPIC_API_KEY=

# Exchange API key - needed only for live trading. Create it with TRADING rights only,
# WITHOUT withdrawal rights, and restrict it to your IP address if the exchange allows it.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Only some exchanges (OKX) use an extra passphrase:
EXCHANGE_API_PASSWORD=
